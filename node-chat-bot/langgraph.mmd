flowchart TD
    START([Start]) --> RETRIEVE["Retrieve matching document chunks from Qdrant"]
    RETRIEVE --> HAS_DOCS{"Any document chunks retrieved?"}

    HAS_DOCS -- Yes --> EVALUATE["Check document sufficiency with OpenAI"]
    EVALUATE --> SUFFICIENT{"Documents answer the query?"}
    SUFFICIENT -- Yes --> DOC_ANSWER["Generate answer from document context"]
    SUFFICIENT -- No --> ROUTE

    HAS_DOCS -- No --> ROUTE["Route unanswered query"]
    ROUTE --> NEEDS_WEB{"Explicit search or time-sensitive query?"}
    NEEDS_WEB -- Yes --> WEB["Search the web with Tavily"]
    NEEDS_WEB -- No --> LLM_ANSWER["Generate answer from general knowledge"]
    WEB --> WEB_ANSWER["Generate answer from web results"]

    DOC_ANSWER --> COMPLETE["Return answer and contextMode: pdf or document"]
    WEB_ANSWER --> COMPLETE_WEB["Return answer, contextMode: web, and sources"]
    LLM_ANSWER --> COMPLETE_LLM["Return answer and contextMode: llm"]

    HISTORY[("Recent conversation history<br/>LangGraph PostgreSQL checkpointer")] -. query context .-> ROUTE
    HISTORY -. answer context .-> DOC_ANSWER
    HISTORY -. answer context .-> WEB_ANSWER
    HISTORY -. answer context .-> LLM_ANSWER
